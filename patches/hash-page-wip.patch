+Datum
+pg_control_hash(PG_FUNCTION_ARGS)
+{
+	Datum		values[2];
+	bool		nulls[2];
+	TupleDesc	tupdesc;
+	HeapTuple	htup;
+	uint64		timeline_hash;
+	uint64		cur_seg_hash;
+	char		hexbuf[16 + 1];
+
+	if (get_call_result_type(fcinfo, NULL, &tupdesc) != TYPEFUNC_COMPOSITE)
+		elog(ERROR, "return type must be a row type");
+
+	timeline_hash = GetCurrentTimelineHash(&cur_seg_hash);
+
+	snprintf(hexbuf, sizeof(hexbuf),
+			 TL_HASH_FORMAT,
+			 timeline_hash);
+	values[0] = CStringGetTextDatum(hexbuf);
+	nulls[0] = false;
+
+	snprintf(hexbuf, sizeof(hexbuf),
+			 TL_HASH_FORMAT,
+			 cur_seg_hash);
+	values[1] = CStringGetTextDatum(hexbuf);
+	nulls[1] = false;
+
+	htup = heap_form_tuple(tupdesc, values, nulls);
+
+	PG_RETURN_DATUM(HeapTupleGetDatum(htup));
+}
