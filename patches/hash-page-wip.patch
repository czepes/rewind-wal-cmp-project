+// @czepes hash
+/*
+ * Rebuild running timeline's hash state by reading in-progress segment
+ * page-by-page and updating cur_seg_hash with each valid (non-torn) page.
+ * Stop on first non-valid (torn) page or at the end of segment.
+ *
+ * written_bytes = number of bytes written into the segment (0, wal_segment_size]
+ *
+ * Returns true if any pages were rehashed, false if segment is empty.
+ */
+bool RehashInProgressSegment(XLogSegNo segno, TimeLineID tli, Size written_bytes)
+{
+	char		path[MAXPGPATH];
+	int			fd;
+	Size		page_offset;
+	Size		full_pages;
+	bool		hashed_any = false;
+
+	if (written_bytes == 0)
+		return false;
+
+	full_pages = written_bytes / XLOG_BLCKSZ;
+
+	if (full_pages == 0)
+		return false;
+
+	ereport(LOG,
+		 	errmsg("timeline rehash: begin rehashing for segment %X/%X of size %zu",
+		 		   (uint32) (segno >> 32),(uint32) segno, written_bytes
+		 ));
+
+	XLogFilePath(path, tli, segno, wal_segment_size);
+	fd = OpenTransientFile(path, O_RDONLY | PG_BINARY);
+
+	if (fd < 0) {
+		ereport(WARNING, errmsg("timeline rehash: failed to open segment %s", path));
+		return false;
+	}
+
+	for (page_offset = 0;
+		 page_offset < full_pages * XLOG_BLCKSZ;
+		 page_offset += XLOG_BLCKSZ)
+	{
+		char			page[XLOG_BLCKSZ];
+		XLogPageHeader	header = (XLogPageHeader) page;
+		XLogRecPtr		pageaddr;
+		Size			nread;
+
+		pageaddr = segno * wal_segment_size + page_offset;
+
+		nread = read(fd, page, XLOG_BLCKSZ);
+		if (nread != XLOG_BLCKSZ)
+		{
+			ereport(LOG,
+		   			errmsg("timeline rehash: failed to read full page at "
+			   			   UINT64_FORMAT ": %zu != %zu",
+			   			   pageaddr, nread, XLOG_BLCKSZ));
+			break;
+		}
+
+		if (header->xlp_magic != XLOG_PAGE_MAGIC)
+		{
+			ereport(LOG,
+		   			errmsg("timeline rehash: magic mismatch at "
+			   			   UINT64_FORMAT ": %u != %u",
+			   			   pageaddr, header->xlp_magic, XLOG_PAGE_MAGIC));
+			break;
+		}
+
+		if (header->xlp_pageaddr != pageaddr)
+		{
+			ereport(LOG,
+		   			errmsg("timeline rehash: page address mismatch at "
+			   			   UINT64_FORMAT ": " UINT64_FORMAT " != " UINT64_FORMAT,
+			   			   pageaddr, header->xlp_pageaddr, pageaddr));
+			break;
+		}
+
+		if (header->xlp_tli != tli)
+		{
+			ereport(LOG,
+		   			errmsg("timeline rehash: skipping page from previous TLI at "
+			   			   UINT64_FORMAT ": %u != %u",
+			   			   pageaddr, header->xlp_tli, tli));
+			continue;
+		}
+
+		XLogCtl->cur_seg_hash =
+			hash_bytes_extended((const unsigned char *) page,
+								XLOG_BLCKSZ,
+								XLogCtl->cur_seg_hash);
+
+		hashed_any = true;
+	}
+
+	CloseTransientFile(fd);
+	return hashed_any;
+}
