+// @czepes hash
+/* Get current timeline's hash from pg_control. */
+uint64 GetCurrentTimelineHash(uint64 *cur_seg_hash)
+{
+	uint64 timeline_hash;
+
+	LWLockAcquire(ControlFileLock, LW_EXCLUSIVE);
+	timeline_hash = ControlFile->timeline_hash;
+	LWLockRelease(ControlFileLock);
+
+	if (cur_seg_hash != NULL) {
+		*cur_seg_hash = XLogCtl->cur_seg_hash;
+	}
+
+	return timeline_hash;
+}
