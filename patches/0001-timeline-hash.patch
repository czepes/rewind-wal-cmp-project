diff --git a/src/backend/utils/misc/pg_controldata.c b/src/backend/utils/misc/pg_controldata.c
index d229ae3..e980338 100644
--- a/src/backend/utils/misc/pg_controldata.c
+++ b/src/backend/utils/misc/pg_controldata.c
@@ -264,3 +264,38 @@ pg_control_init(PG_FUNCTION_ARGS)
 
 	PG_RETURN_DATUM(HeapTupleGetDatum(htup));
 }
+
+Datum
+pg_control_hash(PG_FUNCTION_ARGS)
+{
+	Datum		values[4];
+	bool		nulls[4];
+	TupleDesc	tupdesc;
+	HeapTuple	htup;
+	TLHashState	hstate;
+	char		buf[16 + 1];
+
+	if (get_call_result_type(fcinfo, NULL, &tupdesc) != TYPEFUNC_COMPOSITE)
+		elog(ERROR, "return type must be a row type");
+
+	GetCurrentTimelineHash(&hstate);
+
+	snprintf(buf, sizeof(buf),
+			 UINT64_HEX_FORMAT,
+			 hstate.hash);
+	values[0] = CStringGetTextDatum(buf);
+	nulls[0] = false;
+
+	values[1] = UInt32GetDatum(hstate.tli);
+	nulls[1] = false;
+
+	values[2] = UInt64GetDatum(hstate.segno);
+	nulls[2] = false;
+
+	values[3] = BoolGetDatum(XLogHashIsSet(hstate));
+	nulls[3] = false;
+
+	htup = heap_form_tuple(tupdesc, values, nulls);
+
+	PG_RETURN_DATUM(HeapTupleGetDatum(htup));
+}
