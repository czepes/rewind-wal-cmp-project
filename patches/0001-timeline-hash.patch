diff --git a/src/include/access/timeline_hash.h b/src/include/access/timeline_hash.h
new file mode 100644
index 0000000..7b7fa9c
--- /dev/null
+++ b/src/include/access/timeline_hash.h
@@ -0,0 +1,47 @@
+/*
+ * timeline_hash.h
+ *
+ * Definitions for timeline hash state.
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * src/include/access/timeline.h
+ */
+#ifndef TLHASHST_H
+#define TLHASHST_H
+
+/*
+ * NOTE:
+ * TLHashState is a chained hash state of WAL bytes in current timeline.
+ * It is consistent across nodes that receive identical WAL stream
+ * (replication or archive). It is NOT guaranteed to match across
+ * independent primary nodes, even if they execute similar SQL queries,
+ * because that execution is non-deterministic.
+ *
+ * 'hash'	is hash value, initialized with TLHASHST_SEED;
+ * 'segno'	represent currently hashed segment file number;
+ * 'tli'	represent currently hashed segment file timeline;
+ * 'flags'	represent different hash states.
+ */
+typedef struct {
+	uint64		hash;
+	XLogSegNo	segno;
+	TimeLineID	tli;
+	uint16		flags;
+} TLHashState;
+
+/*
+ * Determines that hash was updated from the start of timeline.
+ */
+#define TLHASHST_FIELDS			4
+#define TLHASHST_SEED			UINT64CONST(0)
+#define TLHASHST_INIT_FLAG		0x0001
+#define TLHASHST_INITIAL		((TLHashState){.hash = TLHASHST_SEED,.segno = 0,.tli = 0,.flags = 0})
+#define TLHASHST_PRINT_ARGS(hs)	(StaticAssertVariableIsOfTypeMacro((hs), TLHashState),(uint64)((hs).hash)),\
+								((uint64)((hs).segno)),((uint32)((hs).tli)),((uint16)((hs).flags))
+#define TLHASHST_SCANF_ARGS(hs)	(StaticAssertVariableIsOfTypeMacro((hs), TLHashState),(uint64*)(&(hs).hash)),\
+								((uint64*)(&(hs).segno)),((uint32*)(&(hs).tli)),((uint16*)(&(hs).flags))
+#define TLHASHST_FORMAT			UINT64_HEX_FORMAT ":" UINT64_FORMAT ":%" PRIu32 ":%" PRIu16
+
+#endif
