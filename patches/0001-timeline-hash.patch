+		if ($ENV{TEST_VERBOSE})
+		{
+			command_ok_verbose(
+				[
+					'pg_rewind',
+					'--debug',
+					'--source-pgdata' => $source_pgdata,
+					'--target-pgdata' => $target_pgdata,
+					'--no-sync',
+					'--no-ensure-shutdown',
+					'--restore-target-wal',
+					'--config-file' => "$target_pgdata/postgresql.conf",
+				],
+				'pg_rewind archive');
+		}
+		else
+		{
+			command_ok(
+				[
+					'pg_rewind',
+					'--debug',
