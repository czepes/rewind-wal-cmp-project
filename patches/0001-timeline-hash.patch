-						 LSN_FORMAT_ARGS(entry->end));
+						 LSN_FORMAT_ARGS(entry->end),
+						 TLHASHST_PRINT_ARGS(entry->hstate));
 		}
 	}
 
@@ -935,6 +955,7 @@ findCommonAncestorTimeline(TimeLineHistoryEntry *a_history, int a_nentries,
 {
 	int			i,
 				n;
+	bool		hash_mismatch = false;
 
 	/*
 	 * Trace the history forward, until we hit the timeline diverge. It may
@@ -950,6 +971,74 @@ findCommonAncestorTimeline(TimeLineHistoryEntry *a_history, int a_nentries,
 		if (a_history[i].tli != b_history[i].tli ||
 			a_history[i].begin != b_history[i].begin)
 			break;
+
+		/*
+		 * Hash mismatch on one of the timelines means that divergence
+		 * occured either:
+		 * - at the begin LSN for both of this timelines
+		 * - at the end LSN of one of this timelines
+		 *
+		 *       hash mistach at TLI 2
+		 *       v
+		 *   -1- | -2--------->
+		 *   -1- | -2- | -3--->
+		 *       ^     ^
+		 *       ^     or from here
+		 *       WAL may diverge from here
+		 *
+		 * We can't determine where the actual divergence is.
+		 *
+		 * This is the serious flaw of HASHing approach:
+		 *
+		 * With UUID: if UUIDs for timelines match we know beforehand
+		 * that this timelines MUST be the same and have identical WAL
+		 * at the begin LSN.
+		 *
+		 * With HASH: if HASHes for timelines match the only thing
+		 * we know is that this timeline WAL content is different
+		 * starting from some LSN. It may be different from the begin
+		 * LSN or at timeline switch of one of the clusters end LSN.
+		 *
+		 * What we can do here is either:
+		 * - walk through WAL and compare hashes for each segment,
+		 *   find first mismatch and start rewind from that segment;
+		 * - simply start rewind from the start of the timeline.
+		 *
+		 * Right now we do the latter and this cause issues:
+		 * Rewind algorithm always supposes that diverence point is
+		 * end LSN, hence walks through previous records to find
+		 * latest checkPoint.
+		 * If we set divergence as begin LSN, there may not be previous
+		 * records to look through => fatal error.
+		 */
+		if (!matchHashStates(a_history[i].hstate, b_history[i].hstate))
+		{
+			hash_mismatch = true;
+			break;
+		}
+	}
+
+	if (hash_mismatch)
+	{
+		if (i > 0)
+		{
+			pg_log_info("hash mismatch at TLI %d", i + 1);
+
+			*recptr = a_history[i].begin; /* == b[i].begin */
+			*tliIndex = i;
+			return;
+		}
+		/*
+		 * WARN:
+		 * We can get here hashes mismatch if at timeline 1.
+		 * We trust that WAL of timeline 1 on both clusters are identical
+		 * to the point of minimal end LSN and set it as divergence point.
+		 * If we set divergence point as begin LSN (which is InvalidXLogRecPtr)
+		 * we will get the pg_rewind will fail to find previous checkpoint and
+		 * will terminate with fatal error.
+		 * TODO: Somehow fix this?
+		 */
+		i++;
 	}
 
 	if (i > 0)
@@ -1215,3 +1304,46 @@ disconnect_atexit(void)
 	if (conn != NULL)
 		PQfinish(conn);
 }
+
+static bool XLogHashIsSet(TLHashState hstate)
+{
+	return hstate.flags & TLHASHST_INIT_FLAG;
+}
+
+static bool matchHashStates(TLHashState a, TLHashState b)
+{
+	/* Unless both hashes are initialized, we cannot match them. */
+	if (!XLogHashIsSet(a) || !XLogHashIsSet(b))
+		return false;
+
+	return a.hash == b.hash && a.tli == b.tli && a.segno == b.segno;
+}
+
+static bool matchCurrentTimelines(TimeLineID source_tli,
+								  TimeLineID target_tli,
+								  TLHashState source_hash,
+								  TLHashState target_hash)
+{
+	if (target_tli != source_tli) {
+		return false;
+	}
+
+	pg_log_info("source and target cluster are on the same timeline");
+
+	if (target_tli == 1)
+	{
+		pg_log_info("source and target clusters are on timeline 1; nothing to rewind");
+		return true;
+	}
+
+	if (!matchHashStates(source_hash, target_hash))
+	{
+		pg_log_info("source and target clusters have different hashes" );
+		return false;
+	}
+	else
+	{
+		pg_log_info("source and target clusters have identical hashes");
+		return true;
+	}
+}
