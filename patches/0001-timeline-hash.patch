+					'--target-pgdata' => $target_pgdata,
+					'--no-sync',
+					'--config-file' => "$tmp_folder/target-postgresql.conf.tmp",
+				],
+				'pg_rewind local');
+		}
+		else
+		{
+			command_ok(
+				[
+					'pg_rewind',
+					'--debug',
+					'--source-pgdata' => $source_pgdata,
+					'--target-pgdata' => $target_pgdata,
+					'--no-sync',
+					'--config-file' => "$tmp_folder/target-postgresql.conf.tmp",
+				],
+				'pg_rewind local');
+		}
+	}
+	elsif ($test_mode eq "remote")
+	{
+		# Do rewind using a remote connection as source, generating
+		# recovery configuration automatically.
+		if ($ENV{TEST_VERBOSE})
+		{
+			command_ok_verbose(
+				[
+					'pg_rewind',
+					'--debug',
+					'--source-server' => $source_connstr,
+					'--target-pgdata' => $target_pgdata,
+					'--no-sync',
+					'--write-recovery-conf',
+					'--config-file' => "$tmp_folder/target-postgresql.conf.tmp",
+				],
+				'pg_rewind remote');
+		}
+		else
+		{
+			command_ok(
+				[
+					'pg_rewind',
+					'--debug',
+					'--source-server' => $source_connstr,
+					'--target-pgdata' => $target_pgdata,
+					'--no-sync',
+					'--write-recovery-conf',
+					'--config-file' => "$tmp_folder/target-postgresql.conf.tmp",
+				],
+				'pg_rewind remote');
+		}
+
+		# Check that pg_rewind with dbname and --write-recovery-conf
