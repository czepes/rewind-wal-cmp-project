+// @czepes hash
+Datum
+pg_control_hash(PG_FUNCTION_ARGS)
+{
+	Datum		values[3];
+	bool		nulls[3];
+	TupleDesc	tupdesc;
+	HeapTuple	htup;
+	TimeLineID	hash_tli;
+	XLogSegNo	hash_segno;
+	char		buf[16 + 1];
+	TLHashState	hash_state;
+
+	if (get_call_result_type(fcinfo, NULL, &tupdesc) != TYPEFUNC_COMPOSITE)
+		elog(ERROR, "return type must be a row type");
+
+	GetCurrentTimelineHash(&hash_state);
+
+	snprintf(buf, sizeof(buf),
+			 UINT64_HEX_FORMAT,
+			 hash_state.hash);
+	values[0] = CStringGetTextDatum(buf);
+	nulls[0] = false;
+
+	values[1] = UInt32GetDatum(hash_state.tli);
+	nulls[1] = false;
+
+	values[2] = UInt64GetDatum(hash_state.segno);
+	nulls[2] = false;
+
+	htup = heap_form_tuple(tupdesc, values, nulls);
+
+	PG_RETURN_DATUM(HeapTupleGetDatum(htup));
+}
