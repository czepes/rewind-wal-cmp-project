+// @czepes hash
+/*
+ * Reset current timeline's hash state to initial.
+ * Must be called at every the timeline switch.
+ */
+void XLogResetHash()
+{
+	LWLockAcquire(ControlFileLock, LW_EXCLUSIVE);
+	XLogResetHashInternal();
+	LWLockRelease(ControlFileLock);
+}
+
+static void XLogResetHashInternal(void)
+{
+	ControlFile->timeline_hash = TIMELINE_HASH_INITIAL_SEED;
+	UpdateControlFile();
+}
+
+/*
+ * Update current timeline's hash state with given 'tli+segno'
+ * segment's hash. Calls XLogHashSegment() to calculate hash.
+ *
+ * Returns true if any pages were hashed,
+ * false if pg_control contains hash for "future" segment
+ * or segment is empty and no pages were hashed.
+ */
+bool XLogUpdateHash(XLogSegNo segno, TimeLineID tli)
+{
+	TimeLineID	hash_tli;
+	XLogSegNo	hash_segno;
+	uint64		old_hash;
+	uint64		new_hash;
+
+	LWLockAcquire(ControlFileLock, LW_SHARED);
+	old_hash = ControlFile->timeline_hash;
+	hash_tli = ControlFile->hash_tli;
+	hash_segno = ControlFile->hash_segno;
+	LWLockRelease(ControlFileLock);
+
+	if (tli < hash_tli) {
+		return false;
+	}
+
+	if (tli == hash_tli && segno <= hash_segno) {
+		return false;
+	}
+
+	new_hash = XLogHashSegment(segno, tli, old_hash);
+
+	if (new_hash == old_hash) {
+		return false;
+	}
+
+	ereport(LOG,
+			errmsg("wal hash update: assigning new hash "
+			UINT64_HEX_FORMAT, new_hash));
+
+	LWLockAcquire(ControlFileLock, LW_EXCLUSIVE);
+	ControlFile->timeline_hash = new_hash;
+	ControlFile->hash_tli = tli;
+	ControlFile->hash_segno = segno;
+	UpdateControlFile();
+	LWLockRelease(ControlFileLock);
+
+	return true;
+}
+
+/*
+ * Calculate segments's hash by reading given 'tli+segno' segment
+ * page-by-page and calculating chained hash for each valid (non-torn) page.
+ * Stop on first non-valid (torn) page or at the end of segment.
+ *
+ * Returns calculated hash.
+ * It equals to TIMELINE_INITAL_HASH_SEED if no calculation was made.
+ */
+uint64 XLogHashSegment(XLogSegNo segno, TimeLineID tli, uint64 seed)
+{
+	char		path[MAXPGPATH];
+	int			fd;
+	Size		page_offset;
+	uint64		hash = seed;
+
+	ereport(LOG,
+			errmsg("wal hash: begin hashing for segment "
+				   UINT64_FORMAT, segno));
+
+	XLogFilePath(path, tli, segno, wal_segment_size);
+	fd = OpenTransientFile(path, O_RDONLY | PG_BINARY);
+
+	if (fd < 0) {
+		ereport(WARNING, errmsg("wal hash: failed to open segment %s", path));
+		return hash;
+	}
+
+	for (page_offset = 0;
+		 page_offset < wal_segment_size;
+		 page_offset += XLOG_BLCKSZ)
+	{
+		char			page[XLOG_BLCKSZ];
+		XLogPageHeader	header = (XLogPageHeader) page;
+		XLogRecPtr		pageaddr;
+		Size			nread;
+		uint64			new_hash = TIMELINE_HASH_INITIAL_SEED;
+
+		pageaddr = segno * wal_segment_size + page_offset;
+
+		nread = read(fd, page, XLOG_BLCKSZ);
+		if (nread != XLOG_BLCKSZ)
+		{
+			ereport(LOG,
+					errmsg("wal hash: failed to read full page at "
+						   "%X/%08X : %zu != %zu",
+						   LSN_FORMAT_ARGS(pageaddr), nread, XLOG_BLCKSZ));
+			break;
+		}
+
+		if (header->xlp_magic != XLOG_PAGE_MAGIC)
+		{
+			ereport(LOG,
+					errmsg("wal hash: magic mismatch at "
+						   "%X/%08X : %u != %u",
+						   LSN_FORMAT_ARGS(pageaddr), header->xlp_magic, XLOG_PAGE_MAGIC));
+			break;
+		}
+
+		if (header->xlp_pageaddr != pageaddr)
+		{
+			ereport(LOG,
+						  errmsg("wal hash: page address mismatch at "
+						   "%X/%08X : %X/%08X != %X/%08X",
+						   LSN_FORMAT_ARGS(pageaddr),
+						   LSN_FORMAT_ARGS(header->xlp_pageaddr),
+						   LSN_FORMAT_ARGS(pageaddr)));
+			break;
+		}
+
+		if (header->xlp_tli != tli)
+		{
+			ereport(LOG,
+					errmsg("wal hash: skipping page from other TLI at "
+						   "%X/%08X : %u != %u",
+						   LSN_FORMAT_ARGS(pageaddr), header->xlp_tli, tli));
+			continue;
+		}
+
+		while (new_hash == TIMELINE_HASH_INITIAL_SEED)
+		{
+			new_hash =
+				hash_bytes_extended((const unsigned char *) page,
+									XLOG_BLCKSZ,
+									hash);
+		}
+		hash = new_hash;
+	}
+
+	CloseTransientFile(fd);
+	return hash;
+}
+
+/* Get current timeline's hash from pg_control. */
+uint64 GetCurrentTimelineHash(TLHashState *state)
+{
+	uint64		timeline_hash;
+
+	LWLockAcquire(ControlFileLock, LW_SHARED);
+	timeline_hash = ControlFile->timeline_hash;
+	if (state != NULL)
+	{
+		state->hash = timeline_hash;
+		state->tli = ControlFile->hash_tli;
+		state->segno = ControlFile->hash_segno;
+	}
+	LWLockRelease(ControlFileLock);
+
+	return timeline_hash;
+}
